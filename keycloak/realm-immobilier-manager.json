{
  "realm": "immobilier-manager",
  "enabled": true,
  "displayName": "Immobilier Manager",
  "sslRequired": "external",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "SUPER_ADMIN",
        "description": "Éditeur de la plateforme : suivi des organisations et des abonnements"
      },
      {
        "name": "ADMIN",
        "description": "Hérité (avant SaaS) : rattache le compte à l'organisation historique comme administrateur"
      },
      {
        "name": "GESTIONNAIRE",
        "description": "Hérité (avant SaaS) : rattache le compte à l'organisation historique comme gestionnaire"
      }
    ]
  },
  "clients": [
    {
      "clientId": "immobilier-manager-backend",
      "name": "Immobilier Manager — backend",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-backend-secret-a-changer",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "gestionnaire.demo",
      "enabled": true,
      "firstName": "Démo",
      "lastName": "Gestionnaire",
      "email": "gestionnaire.demo@immobilier.local",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Demo@2026",
          "temporary": false
        }
      ],
      "realmRoles": [
        "GESTIONNAIRE",
        "ADMIN",
        "SUPER_ADMIN"
      ]
    },
    {
      "username": "service-account-immobilier-manager-backend",
      "enabled": true,
      "serviceAccountClientId": "immobilier-manager-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ],
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "passwordPolicy": "length(8) and digits(1) and notUsername(undefined)"
}
