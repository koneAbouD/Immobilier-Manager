# Variables d'environnement du backend en PRODUCTION (copier en .env, jamais versionné).
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8082

# --- Base de données ---
DB_HOST=
DB_PORT=5432
DB_NAME=immobilier_manager
DB_USERNAME=
DB_PASSWORD=

# --- Keycloak ---
KEYCLOAK_ISSUER_URI=https://auth.example.com/realms/immobilier-manager
KEYCLOAK_JWK_URI=https://auth.example.com/realms/immobilier-manager/protocol/openid-connect/certs
KEYCLOAK_AUTH_SERVER_URL=https://auth.example.com
KEYCLOAK_REALM=immobilier-manager
KEYCLOAK_CLIENT_ID=immobilier-manager-backend
KEYCLOAK_CLIENT_SECRET=

# --- CORS (origines autorisées, séparées par des virgules) ---
CORS_ALLOWED_ORIGINS=
